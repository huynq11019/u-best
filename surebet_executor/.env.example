PORT=3000
REDIS_URL=rediss://default:your_password@your_host:your_port
MVP_MIN_PROFIT_PCT=3.0
STALE_WINDOW_MS=5000
DEDUP_TTL_SECONDS=300
EXECUTION_DEADLINE_MS=20000
MAX_STAKE_PER_LEG=1000
ALLOWED_BOOKMAKERS=saba,x1
LOG_LEVEL=info
BROWSER_HEADLESS=true
BROWSER_POOL_MIN=1
BROWSER_POOL_MAX=2
# Optional: Use real Chrome profile (macOS example: /Users/yourname/Library/Application Support/Google/Chrome)
CHROME_USER_DATA_DIR=
# Optional: Path to Chrome binary (macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome)
CHROME_EXECUTABLE_PATH=

# ── Bookmaker credentials (fill in before running) ────────────────────────────
SABA_BASE_URL=https://saba.sport
SABA_USERNAME=your_saba_user
SABA_PASSWORD=your_saba_pass

X1_BASE_URL=https://1xbet.com
X1_USERNAME=your_x1_user
X1_PASSWORD=your_x1_pass

LU88_BASE_URL=https://lu88.moe
LU88_USERNAME=your_lu88_user
LU88_PASSWORD=your_lu88_pass
